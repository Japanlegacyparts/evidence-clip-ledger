{
  "manifest_version": 3,
  "name": "Evidence Clip Ledger",
  "version": "1.0.0",
  "description": "Save the current page as a graded evidence record and export a local source ledger.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "action": {
    "default_title": "Save page evidence",
    "default_popup": "popup.html"
  },
  "options_page": "archive.html",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
